# Copy this file to .env and fill it in. Never commit .env.

# "prod" for the real server. "dev" for a local environment
ENVIRONMENT=prod

# required in prod
SITE_URL=https://api.dinopoloclub.com
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
POSTGRES_PASSWORD=change-me

SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_TEAM_ID=

TIME_ZONE=Pacific/Auckland
WEB_PORT=9092
GUNICORN_WORKERS=3
MAX_ATTACHMENT_MB_PER_REPORT=10